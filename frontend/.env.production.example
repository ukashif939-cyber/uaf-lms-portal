# Copy to .env.production before Firebase static build
BUILD_FOR_FIREBASE=1
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=uaf-lms-main.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=uaf-lms-main
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=uaf-lms-main.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
